pipeline {
    agent {
        node {
            label 'maven'               // 使用现有的 maven 节点（Podman 镜像）
        }
    }

    parameters {
        string(name: 'TAG_NAME', defaultValue: '', description: '自定义标签（可选）')
    }

    environment {
        // ----- 镜像仓库配置 -----
        REGISTRY = '192.168.56.100:30002'           // Harbor 地址（HTTP）
        DOCKERHUB_NAMESPACE = 'kubesphere'               // Harbor 项目名称
        APP_NAME = 'kubesphere-springboot-devops-sample'

        // ----- 凭证 ID（需在 Jenkins 中提前创建）-----
        HARBOR_CREDENTIAL_ID = 'harbor-credential'  // Harbor 用户名/密码 凭证 ID
        KUBECONFIG_CREDENTIAL_ID = 'demo-deploy-certificate'  // kubeconfig 凭证 ID
    }

    stages {
        stage('checkout scm') {
            steps {
                checkout(scm)
            }
        }

        stage('build jar') {
            steps {
                container('maven') {
                    sh 'mvn clean package'          // 编译打包，生成 target/*.jar
                }
            }
        }

        stage('build and push image') {
            when {
                branch 'master'                     // 仅 master 分支执行镜像构建推送
            }
            steps {
                container('maven') {
                    withCredentials([usernamePassword(
                        credentialsId: env.HARBOR_CREDENTIAL_ID,
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )]) {
                        sh '''
                            # 定义镜像标签
                            IMAGE_TAG="SNAPSHOT-${BRANCH_NAME}-${BUILD_NUMBER}"
                            FULL_IMAGE="${REGISTRY}/${DOCKERHUB_NAMESPACE}/${APP_NAME}:${IMAGE_TAG}"
                            LATEST_IMAGE="${REGISTRY}/${DOCKERHUB_NAMESPACE}/${APP_NAME}:latest"

                            # 使用 Podman 登录 Harbor（HTTP 仓库需添加 --tls-verify=false） 查看jenkins配置字典：kubectl edit cm jenkins-casc-config -n kubesphere-devops-system
                            podman login -u "${HARBOR_USERNAME}" -p "${HARBOR_PASSWORD}" "${REGISTRY}" --tls-verify=false

                            # 构建镜像
                            podman build -f build/Dockerfile-dev -t "${FULL_IMAGE}" .

                            # 打 latest 标签
                            podman tag "${FULL_IMAGE}" "${LATEST_IMAGE}"

                            # 推送两个标签
                            podman push "${FULL_IMAGE}" --tls-verify=false
                            podman push "${LATEST_IMAGE}" --tls-verify=false
                        '''
                    }
                }
            }
        }

        stage('deploy to dev') {
            agent {
                node {
                    label 'base'                    // 使用 base 节点执行部署（kubectl 可用）
                }
            }
            when {
                branch 'master'
            }
            steps {
                container('base') {
                    input(id: 'deploy-to-dev', message: 'deploy to dev?')
                    withCredentials([kubeconfigFile(
                        credentialsId: env.KUBECONFIG_CREDENTIAL_ID,
                        variable: 'KUBECONFIG'
                    )]) {
                        // 用 envsubst 替换 YAML 中的环境变量，然后 apply
                        sh 'envsubst < deploy/dev-deploy.yaml | kubectl apply -f -'
                    }
                }
            }
        }
    }
}